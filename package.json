{
  "name": "empatia-care",
  "version": "1.0.0",
  "private": true,
  "description": "A secure, invite-only appointment portal for a medical clinic.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
