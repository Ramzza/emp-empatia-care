{
  "name": "emp-empatia-care",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-minimizing appointment portal for a medical clinic.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import tsx server.ts",
    "import-cnps": "node --env-file-if-exists=.env --import tsx scripts/import-cnps.ts",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
