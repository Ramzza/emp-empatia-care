NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/empatia.sqlite

# Required in production. Use a unique, random value of at least 32 bytes.
APP_SECRET=

# Required for the clinic administrator; credentials are not stored in SQLite.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required in production. Create a Cloudflare Turnstile widget for your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Configure an SMTP server for appointment confirmation emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
